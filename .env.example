# ─── Application ──────────────────────────────────────────
NODE_ENV=development
PORT=5001

# ─── Database (Neon Postgres) ─────────────────────────────
# Get this from your Neon project dashboard → Connection Details.
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Admin ────────────────────────────────────────────────
# Optional. When set, admin routes require an `x-admin-secret` header matching
# this value IN ADDITION to a valid admin JWT (defense-in-depth). Leave unset to
# gate admin access by the admin JWT role alone.
ADMIN_SECRET=

# ─── Frontend ─────────────────────────────────────────────
CLIENT_URL=http://localhost:3000

# ─── Logging ──────────────────────────────────────────────
LOG_LEVEL=info
